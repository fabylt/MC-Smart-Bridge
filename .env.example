# Porta del server HTTP (3000 in sviluppo / preview, 8000 consigliata dietro Nginx su Oracle Cloud VM)
PORT=3000

# Password di accesso all'interfaccia web (se vuota al primo avvio, viene richiesta la configurazione guidata)
APP_PASSWORD=

# Chiave API Google Gemini (usata lato server per la conversione strutturata delle ricette)
GEMINI_API_KEY=

# Credenziali account cloud Silvercrest Monsieur Cuisine Smart (monsieur-cuisine.com)
MC_EMAIL=
MC_PASSWORD=

# Moltiplicatore predefinito per il riproporzionamento (es. 1.5 per portare 4 porzioni a 5 abbondanti)
DEFAULT_MULTIPLIER=1.5

# Impostazioni portale Monsieur Cuisine (opzionali)
MC_BASE_URL=https://www.monsieur-cuisine.com
MC_LOCALE=it-IT
